---
import Layout from '../layouts/Layout.astro';
import tuttiEventi from '../data/eventi.json';
import libri from '../data/pubblicazioni.json';

// Ottieni la data di oggi nel formato YYYY-MM-DD
const oggi = new Date().toISOString().split('T')[0];

// Prossimi 3 eventi
const prossimiEventi = tuttiEventi
  .filter((evento) => evento.data >= oggi)
  .sort((a, b) => new Date(a.data).getTime() - new Date(b.data).getTime())
  .slice(0, 3);

// Primo libro disponibile
const libro = libri[0];
---

<Layout title="Home">

  <!-- =========================
       HERO
       ========================= -->
  <section class="hero">

    <img
      src={`${import.meta.env.BASE_URL}/foto-andrea.JPG`}
      alt="Andrea Borello"
      class="hero-background"
    />

    <div class="hero-overlay"></div>

    <div class="hero-content">
      <img
        src={`${import.meta.env.BASE_URL}/logo-pd.png`}
        alt="Partito Democratico"
        class="pd-logo"
      />

      <h1>Andrea Borello</h1>

      <p class="hero-subtitle">
        Costruiamo insieme un futuro più equo,
        sostenibile e vicino alle persone.
      </p>
    </div>

  </section>


  <!-- =========================
       BIOGRAFIA
       ========================= -->
  <section class="bio-section">
    <div class="bio-container">

      <div class="bio-content">
        <span class="section-label">CHI SONO</span>

        <h2>Andrea Borello</h2>

        <p>
          Una breve presentazione di Andrea Borello, del suo percorso
          personale e politico e dell'impegno quotidiano al servizio
          della comunità.
        </p>

        <p>
          Scopri la sua storia, le esperienze che ne hanno segnato
          il percorso e le idee che guidano il suo impegno.
        </p>

        <a
          href={`${import.meta.env.BASE_URL}/biografia`}
          class="btn btn-primary"
        >
          Scopri la biografia →
        </a>
      </div>

      <div class="bio-image-wrapper">
        <img
          src={`${import.meta.env.BASE_URL}/foto-andrea.JPG`}
          alt="Andrea Borello"
          class="bio-image"
        />
      </div>

    </div>
  </section>


  <!-- =========================
       LIBRO
       ========================= -->
  {libro && (
    <section class="book-section">
      <div class="book-container">

        <div class="book-image-wrapper">
          <img
            src={`${import.meta.env.BASE_URL}${libro.copertina}`}
            alt={`Copertina di ${libro.titolo}`}
            class="book-cover"
          />
        </div>

        <div class="book-content">
          <span class="section-label">PUBBLICAZIONE</span>

          <h2>{libro.titolo}</h2>

          {libro.sottotitolo && (
            <p class="book-subtitle">
              {libro.sottotitolo}
            </p>
          )}

          <div class="book-meta">
            {libro.editore && <span>{libro.editore}</span>}
            {libro.anno && <span>{libro.anno}</span>}
          </div>

          {libro.descrizione && (
            <p class="book-description">
              {libro.descrizione}
            </p>
          )}

          <a
            href={`${import.meta.env.BASE_URL}/pubblicazioni`}
            class="btn btn-primary"
          >
            Scopri il libro →
          </a>
        </div>

      </div>
    </section>
  )}


  <!-- =========================
       PROSSIMI EVENTI
       ========================= -->
  <section class="events-section">
    <div class="page-container">

      <span class="section-label section-label-center">
        VIENI A CONOSCERMI
      </span>

      <h2 class="section-title">Prossimi Eventi</h2>

      {prossimiEventi.length === 0 ? (
        <p class="no-data">
          Nessun evento in programma al momento.
        </p>
      ) : (
        <div class="events-list">

          {prossimiEventi.map((evento) => (
            <article class="event-card">

              <h3>{evento.titolo}</h3>

              <div class="event-meta">
                📅 <strong>Data:</strong> {evento.data}
                alle {evento.ora}
                &nbsp; | &nbsp;
                📍 <strong>Luogo:</strong> {evento.luogo}
              </div>

              <p>{evento.descrizione}</p>

            </article>
          ))}

        </div>
      )}

      <div class="center-btn">
        <a
          href={`${import.meta.env.BASE_URL}/eventi`}
          class="btn btn-primary"
        >
          Tutti gli eventi →
        </a>
      </div>

    </div>
  </section>

</Layout>


<style>

  /* =========================
     HERO FULL SCREEN
     ========================= */

  .hero {
    position: relative;
    width: 100%;
    height: calc(100vh - 78px);
    min-height: 600px;
    overflow: hidden;
    color: white;
  }

  .hero-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  /*
   * Sfumatura rossa:
   * molto presente a sinistra,
   * quasi trasparente verso destra.
   */
  .hero-overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        90deg,
        rgba(170, 0, 0, 0.90) 0%,
        rgba(190, 20, 20, 0.70) 30%,
        rgba(211, 47, 47, 0.25) 60%,
        rgba(211, 47, 47, 0) 85%
      );
  }

  .hero-content {
    position: absolute;
    left: 8%;
    bottom: 10%;

    max-width: 520px;

    z-index: 2;
  }

  .pd-logo {
    width: 105px;
    height: auto;
    margin-bottom: 1.2rem;

    background: white;
    border-radius: 50%;
    padding: 3px;

    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.25);
  }

  .hero-content h1 {
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.95;
    font-weight: 900;

    margin-bottom: 1.2rem;

    letter-spacing: -2px;

    text-shadow: 0 3px 12px rgba(0, 0, 0, 0.25);
  }

  .hero-subtitle {
    font-size: clamp(1.1rem, 2vw, 1.45rem);
    line-height: 1.5;
    max-width: 480px;

    font-weight: 400;

    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }


  /* =========================
     GENERALE
     ========================= */

  .page-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
  }

  .section-label {
    display: block;

    color: var(--pd-red);

    font-size: 0.8rem;
    font-weight: 800;

    letter-spacing: 2px;

    margin-bottom: 0.7rem;
  }

  .section-label-center {
    text-align: center;
  }


  /* =========================
     BIOGRAFIA
     ========================= */

  .bio-section {
    background: white;
    padding: 6rem 1.5rem;
  }

  .bio-container {
    max-width: 1100px;
    margin: 0 auto;

    display: grid;
    grid-template-columns: 1fr 0.9fr;

    align-items: center;

    gap: 5rem;
  }

  .bio-content h2 {
    font-size: clamp(2rem, 4vw, 3rem);

    margin-bottom: 1.5rem;

    color: #111827;
  }

  .bio-content p {
    color: #4b5563;

    font-size: 1.05rem;
    line-height: 1.7;

    margin-bottom: 1rem;

    max-width: 550px;
  }

  .bio-content .btn {
    margin-top: 1rem;
  }

  .bio-image-wrapper {
    position: relative;
  }

  .bio-image {
    display: block;

    width: 100%;
    aspect-ratio: 4 / 5;

    object-fit: cover;

    border-radius: 4px;

    box-shadow: 15px 15px 0 var(--pd-red);
  }


  /* =========================
     LIBRO
     ========================= */

  .book-section {
    background-color: #f3f4f6;

    padding: 6rem 1.5rem;
  }

  .book-container {
    max-width: 1000px;

    margin: 0 auto;

    display: grid;

    grid-template-columns: 280px 1fr;

    align-items: center;

    gap: 5rem;
  }

  .book-image-wrapper {
    text-align: center;
  }

  .book-cover {
    display: inline-block;

    width: 100%;
    max-width: 280px;

    height: auto;

    box-shadow:
      0 15px 30px rgba(0, 0, 0, 0.18);

    border-radius: 2px;
  }

  .book-content h2 {
    font-size: clamp(2rem, 4vw, 3rem);

    color: #111827;

    line-height: 1.1;

    margin-bottom: 0.5rem;
  }

  .book-subtitle {
    font-size: 1.1rem;

    color: #6b7280;

    margin-bottom: 1.2rem;
  }

  .book-meta {
    display: flex;

    gap: 1rem;

    margin-bottom: 1.5rem;

    font-size: 0.9rem;

    color: #6b7280;
  }

  .book-meta span + span::before {
    content: "•";

    margin-right: 1rem;

    color: var(--pd-red);
  }

  .book-description {
    color: #4b5563;

    line-height: 1.7;

    margin-bottom: 1.5rem;

    max-width: 650px;
  }


  /* =========================
     EVENTI
     ========================= */

  .events-section {
    background: white;

    padding: 1rem 0 5rem;
  }

  .section-title {
    text-align: center;

    font-size: clamp(2rem, 4vw, 2.7rem);

    margin-bottom: 2rem;

    color: #111827;
  }

  .events-list {
    display: flex;
    flex-direction: column;

    gap: 1rem;

    margin-bottom: 2rem;
  }

  .event-card {
    background: white;

    border-radius: 4px;

    padding: 1.5rem;

    border-left: 5px solid var(--pd-red);

    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.06);
  }

  .event-card h3 {
    margin-bottom: 0.5rem;

    color: #111827;
  }

  .event-meta {
    font-size: 0.85rem;

    color: #6b7280;

    margin-bottom: 0.7rem;
  }

  .event-card p {
    line-height: 1.6;

    color: #4b5563;
  }


  /* =========================
     BUTTONS
     ========================= */

  .center-btn {
    text-align: center;
  }

  .btn {
    display: inline-block;

    padding: 0.8rem 1.5rem;

    border-radius: 4px;

    text-decoration: none;

    font-weight: 700;

    transition:
      background-color 0.2s ease,
      transform 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background-color: var(--pd-red);

    color: white;
  }

  .btn-primary:hover {
    background-color: var(--pd-red-dark);
  }


  /* =========================
     NESSUN DATO
     ========================= */

  .no-data {
    text-align: center;

    color: #6b7280;

    padding: 2rem;
  }


  /* =========================
     MOBILE
     ========================= */

  @media (max-width: 768px) {

    .hero {
      height: calc(100vh - 65px);
      min-height: 550px;
    }

    .hero-background {
      object-position: 60% center;
    }

    .hero-overlay {
      background:
        linear-gradient(
          180deg,
          rgba(170, 0, 0, 0.05) 20%,
          rgba(170, 0, 0, 0.35) 45%,
          rgba(170, 0, 0, 0.92) 100%
        );
    }

    .hero-content {
      left: 1.5rem;
      right: 1.5rem;
      bottom: 8%;
    }

    .pd-logo {
      width: 80px;
      margin-bottom: 1rem;
    }

    .hero-content h1 {
      font-size: clamp(2.7rem, 12vw, 4rem);
      letter-spacing: -1px;
    }

    .hero-subtitle {
      font-size: 1.05rem;
    }


    /* BIO */

    .bio-section {
      padding: 4rem 1.5rem;
    }

    .bio-container {
      grid-template-columns: 1fr;

      gap: 3rem;
    }

    .bio-image-wrapper {
      order: -1;
    }

    .bio-image {
      aspect-ratio: 16 / 10;

      box-shadow: 8px 8px 0 var(--pd-red);
    }


    /* LIBRO */

    .book-section {
      padding: 4rem 1.5rem;
    }

    .book-container {
      grid-template-columns: 1fr;

      gap: 2.5rem;

      text-align: center;
    }

    .book-image-wrapper {
      order: -1;
    }

    .book-cover {
      max-width: 220px;
    }

    .book-meta {
      justify-content: center;
    }


    /* EVENTI */

    .page-container {
      padding: 4rem 1.5rem;
    }

    .events-section {
      padding-bottom: 3rem;
    }

  }

</style>
```
