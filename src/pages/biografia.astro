---
import Layout from '../layouts/Layout.astro';
import tappeBiografia from '../data/biografia.json';
---

<Layout title="Biografia">
  <!-- INTRODUZIONE DELLA PAGINA -->
  <div class="page-header">
    <div class="container">
      <h1>La mia storia</h1>
      <p>Un percorso fatto di passione civile, impegno sul territorio e battaglie per la comunità.</p>
    </div>
  </div>

  <div class="container page-content">
    <div class="bio-timeline">
      {tappeBiografia.map((tappa, index) => (
        <article class={`bio-row ${index % 2 !== 0 ? 'reverse' : ''}`}>
          <div class="bio-image-col">
            <div class="bio-gallery">
              {tappa.immagini.map((img) => (
                <img 
                  src={`${import.meta.env.BASE_URL}${img.src}`} 
                  alt={img.alt} 
                  class="bio-image" 
                />
              ))}
            </div>
          </div>
          <div class="bio-text-col">
            <p>{tappa.testo}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>

<style>
  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  /* Header della pagina */
  .page-header {
    background-color: #1f2937;
    color: white;
    padding: 3.5rem 0;
    text-align: center;
    border-bottom: 4px solid var(--pd-red);
  }

  .page-header h1 {
    font-size: 2.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
  }

  .page-header p {
    font-size: 1.1rem;
    color: #d1d5db;
    max-width: 600px;
    margin: 0 auto;
  }

  .page-content {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  /* Layout ad alternanza (Zig-Zag) */
  .bio-timeline {
    display: flex;
    flex-direction: column;
    gap: 4rem;
  }

  .bio-row {
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  /* Inverte la colonna per i paragrafi dispari */
  .bio-row.reverse {
    flex-direction: row-reverse;
  }

  /* Colonna Immagine / Galleria */
  .bio-image-col {
    flex: 1;
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .bio-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    width: 100%;
    max-width: 360px; /* Evita che un'unica foto si allarghi troppo */
  }

  .bio-image {
    width: 100%;
    aspect-ratio: 1 / 1; /* Mantiene la foto quadrata */
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    border: 1px solid #e5e7eb;
  }

  /* Colonna Testo */
  .bio-text-col {
    flex: 1;
  }

  .bio-text-col p {
    font-size: 1.05rem;
    color: #4b5563;
    line-height: 1.7;
    margin: 0;
  }

  /* Responsive: su schermi piccoli (smartphone) diventa tutto verticale */
  @media (max-width: 768px) {
    .bio-row,
    .bio-row.reverse {
      flex-direction: column;
      gap: 1.5rem;
    }

    .bio-gallery {
      max-width: 100%;
    }

    .bio-timeline {
      gap: 3rem;
    }
  }
</style>